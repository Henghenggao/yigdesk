{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "verdict",
    "summary",
    "metrics",
    "inspected_evidence",
    "draft_status"
  ],
  "properties": {
    "packet_id": { "type": "string", "pattern": "^cpkt-[a-f0-9]+$" },
    "verdict": { "type": "string", "enum": ["READY FOR CFO", "HOLD"] },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "A concise qualitative explanation containing no figures."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["net_arr", "arr_impact", "gross_margin", "headroom"],
      "properties": {
        "net_arr": { "type": "string" },
        "arr_impact": { "type": "string" },
        "gross_margin": { "type": "string" },
        "headroom": { "type": "string" }
      }
    },
    "inspected_evidence": { "type": "string" },
    "draft_status": { "type": "string", "const": "NOT_SENT" }
  }
}
