{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidate_status": {
      "type": "string",
      "const": "READY_FOR_EXTERNAL_AUDIT"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "source_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "submitted_discount_pct": {
      "type": "string",
      "minLength": 1
    },
    "financially_feasible": {
      "type": "boolean"
    },
    "exact_max_discount_pct": {
      "type": "string",
      "minLength": 1
    },
    "largest_safe_step_pct": {
      "type": "string",
      "minLength": 1
    },
    "first_unsafe_pct": {
      "type": "string",
      "minLength": 1
    },
    "recommended_discount_pct": {
      "type": "null"
    },
    "commercial_optimality_proven": {
      "type": "boolean",
      "const": false
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "candidate_status",
    "revision_id",
    "source_fingerprint",
    "packet_id",
    "submitted_discount_pct",
    "financially_feasible",
    "exact_max_discount_pct",
    "largest_safe_step_pct",
    "first_unsafe_pct",
    "recommended_discount_pct",
    "commercial_optimality_proven",
    "decision"
  ]
}
